{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ba-intake-request",
  "title": "BA Intake enhancement request",
  "type": "object",
  "required": ["requestId", "requestText"],
  "additionalProperties": false,
  "properties": {
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "title": { "type": "string", "maxLength": 255 },
    "requestText": { "type": "string", "minLength": 10, "maxLength": 20000 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "issueKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+-[0-9]+$" },
        "url": { "type": "string" }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "email": { "type": "string" } }
    },
    "links": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "object" }
  }
}
